#include? "Local.xcconfig"

DEVELOPMENT_TEAM = $(LOCALISTEN_DEVELOPMENT_TEAM)
PRODUCT_BUNDLE_IDENTIFIER = $(LOCALISTEN_BUNDLE_IDENTIFIER)